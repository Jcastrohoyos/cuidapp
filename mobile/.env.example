# Copia este archivo a .env (nunca commitear .env) y completa los valores.
# Cada perfil de build en eas.json puede sobrescribirlos.

# Obligatoria en builds de distribución (development/preview/production).
# En development puede dejarse vacío para activar los datos de demostración.
EXPO_PUBLIC_API_URL=https://api.cuidapp.example

# Canal de OTA (solo si app.json tiene updates.url configurado).
EXPO_UPDATES_URL=https://u.expo.dev/<TU-PROJECT-ID>

# Opcional
EXPO_PUBLIC_APP_ENV=production