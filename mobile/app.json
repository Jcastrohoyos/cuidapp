{
  "expo": {
    "name": "Cuidapp",
    "slug": "cuidapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cuidapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFA",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/3448cdfc-e207-4af3-bebb-b2ece0832907",
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.cuidapp.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cuidapp.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite que Cuidapp guarde tu sesión de forma segura con Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-updates",
      "expo-font",
      "@react-native-vector-icons/lucide",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sqlite",
      // "./plugins/withWatermelonDB.js", // TEMPORARILY DISABLED for build debugging
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F766E",
          "sounds": [
            "./assets/sounds/notification.wav"
          ],
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3448cdfc-e207-4af3-bebb-b2ece0832907"
      }
    }
  }
}
