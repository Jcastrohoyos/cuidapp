{
  "expo": {
    "name": "Cuidapp",
    "slug": "cuidapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cuidapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFA",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.cuidapp.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cuidapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permite que Cuidapp guarde tu sesión de forma segura con Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-updates",
      "expo-font",
      "@react-native-vector-icons/lucide"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3448cdfc-e207-4af3-bebb-b2ece0832907"
      }
    }
  }
}
